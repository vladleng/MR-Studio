option(MRS_BUILD_ARA "Build opt-in ARA 2 host foundation (no clip integration)" OFF)
set(MRS_ARA_SDK_ROOT "" CACHE PATH "Local official ARA SDK releases/2.3.0")
if(MRS_BUILD_ARA)
  if(NOT MRS_BUILD_VST3)
    message(FATAL_ERROR "ARA foundation requires MRS_BUILD_VST3=ON")
  endif()
  foreach(required ARA_API/ARAInterface.h ARA_Library/Dispatch/ARAHostDispatch.cpp NOTICE.txt)
    if(NOT EXISTS "${MRS_ARA_SDK_ROOT}/${required}")
      message(FATAL_ERROR "Set MRS_ARA_SDK_ROOT to populated ARA SDK releases/2.3.0; configure never downloads it")
    endif()
  endforeach()
  # Verify the public release and pinned submodules, not an arbitrary SDK HEAD.
  find_package(Git REQUIRED)
  foreach(pin ".|0005c532bb03eb210e7bb490329fc6d7ba1792c7" "ARA_API|65ec5c43b943a48cb5446f448a0492db6af8534b" "ARA_Library|d18a6a5e489816316be84a9de0eaf7307bc1abe4")
    string(REPLACE "|" ";" fields "${pin}")
    list(GET fields 0 directory)
    list(GET fields 1 expected)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${MRS_ARA_SDK_ROOT}/${directory}" rev-parse HEAD
      OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
      message(FATAL_ERROR "ARA SDK ${directory} must match releases/2.3.0 pin ${expected}")
    endif()
  endforeach()
  set(ARA_API_DIR "${MRS_ARA_SDK_ROOT}/ARA_API")
  add_subdirectory("${MRS_ARA_SDK_ROOT}/ARA_Library" "${CMAKE_BINARY_DIR}/ara-sdk" EXCLUDE_FROM_ALL)
  add_library(mrs_ara STATIC core/processing/src/ara.cpp core/processing/src/ara_scan.cpp core/processing/src/ara_arrangement.cpp)
  target_include_directories(mrs_ara PUBLIC core/include)
  target_include_directories(mrs_ara SYSTEM PRIVATE "${MRS_ARA_SDK_ROOT}" "${MRS_VST3_SDK_ROOT}")
  target_compile_features(mrs_ara PUBLIC cxx_std_20)
  target_compile_definitions(mrs_ara PUBLIC MRS_HAS_ARA=1)
  target_compile_definitions(mrs_ara PRIVATE NOMINMAX=1)
  target_compile_options(mrs_ara PRIVATE /W4 /WX /utf-8)
  target_link_libraries(mrs_ara PRIVATE mrs_vst3 ARA_Host_Library mrs_audio)
  add_executable(mrs_ara_scan tools/ara_scan.cpp)
  target_link_libraries(mrs_ara_scan PRIVATE mrs_ara)
  if(BUILD_TESTING)
    set(MRS_ARA_TEST_PLUGIN "" CACHE FILEPATH "Local Celemony ARATestPlugIn.vst3")
    set(MRS_ARA_JUCE_TEST_PLUGIN "" CACHE FILEPATH "Local JUCE ARAPluginDemo.vst3")
    add_executable(mrs_ara_tests tests/ara_tests.cpp)
    target_link_libraries(mrs_ara_tests PRIVATE mrs_ara)
    add_library(mrs_ara_invalid_fixture MODULE tests/ara_fixture.cpp "${MRS_VST3_SDK_ROOT}/public.sdk/source/main/dllmain.cpp")
    target_include_directories(mrs_ara_invalid_fixture SYSTEM PRIVATE "${MRS_ARA_SDK_ROOT}" "${MRS_VST3_SDK_ROOT}")
    target_compile_features(mrs_ara_invalid_fixture PRIVATE cxx_std_20)
    target_link_libraries(mrs_ara_invalid_fixture PRIVATE sdk)
    set_target_properties(mrs_ara_invalid_fixture PROPERTIES PREFIX "" SUFFIX ".vst3")
    add_dependencies(mrs_ara_tests mrs_ara_scan mrs_ara_invalid_fixture mrs_vst3_fixture)
    add_test(NAME ara_unsupported COMMAND mrs_ara_tests $<TARGET_FILE:mrs_vst3_fixture> unsupported $<TARGET_FILE:mrs_ara_scan>)
    add_test(NAME ara_incompatible COMMAND mrs_ara_tests $<TARGET_FILE:mrs_ara_invalid_fixture> incompatible $<TARGET_FILE:mrs_ara_scan>)
    set_tests_properties(ara_incompatible PROPERTIES TIMEOUT 15)
    foreach(vendor TEST JUCE_TEST)
      if(MRS_ARA_${vendor}_PLUGIN)
        add_test(NAME ara_${vendor}_lifecycle COMMAND mrs_ara_tests "${MRS_ARA_${vendor}_PLUGIN}" available $<TARGET_FILE:mrs_ara_scan>)
        set_tests_properties(ara_${vendor}_lifecycle PROPERTIES TIMEOUT 30)
      endif()
    endforeach()
    set_tests_properties(ara_unsupported PROPERTIES TIMEOUT 15)
  endif()
endif()
