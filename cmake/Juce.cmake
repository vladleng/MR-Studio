  add_dependencies(MRLiveJuce mrs_ara_scan)
  add_custom_command(TARGET MRLiveJuce POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
    "$<TARGET_FILE:mrs_ara_scan>" "$<TARGET_FILE_DIR:MRLiveJuce>/mrs_ara_scan.exe")
endif()
