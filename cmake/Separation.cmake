# NON-RT Studio-only service. Standalone check builds JUCE core, no device/GUI/SDK
# host is required. A normal Studio build keeps its existing ARA2 ON profile.
if(NOT TARGET juce::juce_core)
  set(MRS_JUCE_SDK_ROOT "" CACHE PATH "Pinned JUCE 9.0.3 sources")
  file(READ "${MRS_JUCE_SDK_ROOT}/CMakeLists.txt" juce_source)
  if(NOT juce_source MATCHES "project\\(JUCE VERSION 9\\.0\\.3")
    message(FATAL_ERROR "Separation check requires pinned JUCE 9.0.3")
  endif()
  add_subdirectory("${MRS_JUCE_SDK_ROOT}" "${CMAKE_BINARY_DIR}/juce-sdk" EXCLUDE_FROM_ALL)
endif()
add_library(mrs_separation STATIC apps/studio-juce/src/SeparationRunner.cpp apps/studio-juce/src/SeparationModels.cpp)
target_include_directories(mrs_separation PUBLIC apps/studio-juce/src)
target_compile_features(mrs_separation PUBLIC cxx_std_20)
target_compile_definitions(mrs_separation PUBLIC JUCE_WEB_BROWSER=0 JUCE_USE_CURL=0)
target_link_libraries(mrs_separation PRIVATE mrs_audio juce::juce_cryptography winhttp shell32 ole32 uuid PUBLIC juce::juce_core)
if(MSVC)
  target_compile_options(mrs_separation PRIVATE /W4 /WX /utf-8)
endif()
if(TARGET MoonRiverStudioJuce)
  target_link_libraries(MoonRiverStudioJuce PRIVATE mrs_separation)
  target_compile_definitions(MoonRiverStudioJuce PRIVATE MRS_SEPARATION_UI=1)
  target_sources(MoonRiverStudioJuce PRIVATE apps/studio-juce/src/SeparationModelsView.cpp)
  target_link_libraries(MoonRiverStudioJuce PRIVATE juce::juce_cryptography)
  if(MSVC)
    set_source_files_properties(apps/studio-juce/src/SeparationModelsView.cpp PROPERTIES COMPILE_OPTIONS "/WX")
  endif()
  add_custom_command(TARGET MoonRiverStudioJuce POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${PROJECT_SOURCE_DIR}/tools/separation/worker.py" "$<TARGET_FILE_DIR:MoonRiverStudioJuce>/mr_separation_worker.py"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "${PROJECT_SOURCE_DIR}/tools/separation/requirements-cpu.txt" "$<TARGET_FILE_DIR:MoonRiverStudioJuce>/mr_separation_requirements.txt")
  if(BUILD_TESTING)
    add_test(NAME juce_separation_models COMMAND MoonRiverStudioJuce --separation-models-smoke)
    set_tests_properties(juce_separation_models PROPERTIES TIMEOUT 30 RUN_SERIAL TRUE)
  endif()
endif()
add_executable(mrs_separation_check tools/separation_check.cpp)
target_compile_features(mrs_separation_check PRIVATE cxx_std_20)
target_link_libraries(mrs_separation_check PRIVATE mrs_separation mrs_audio juce::juce_cryptography)
if(MSVC)
  target_compile_options(mrs_separation_check PRIVATE /W4 /WX /utf-8)
endif()
if(BUILD_TESTING)
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  add_test(NAME separation_host COMMAND mrs_separation_check --self-test
    "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/tests/separation_fake_worker.py")
  set_tests_properties(separation_host PROPERTIES TIMEOUT 60)
  add_test(NAME separation_models COMMAND mrs_separation_check --manager-self-test "${PROJECT_SOURCE_DIR}/tools/separation/requirements-cpu.txt")
  set_tests_properties(separation_models PROPERTIES TIMEOUT 60)
endif()
