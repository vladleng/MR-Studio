+// MR Studio optional stem constraint: teacher-force the canonical program in
+// each chunk prelude and constrain program/drum vocabulary BEFORE argmax.
+// This is decoder conditioning, not a learned instrument-group embedding or a
+// post-hoc MIDI remap. Auto (-1) preserves the upstream greedy path exactly.
+static int mrs_stem_program = -1;
+static bool mrs_token_allowed(int token) {
+    if (mrs_stem_program < 0) return true;
+    if (token >= 1135 && token < 1265) return token == 1135 + mrs_stem_program;
+    if (mrs_stem_program == 128 && token >= 1004 && token < 1132) return false;
+    if (mrs_stem_program != 128 && token >= 1265 && token < 1393) return false;
+    return true;
+}
