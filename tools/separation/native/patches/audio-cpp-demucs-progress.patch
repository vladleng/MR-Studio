+audiocpp_status mrs_audiocpp_request_set_chunk_progress(
+    audiocpp_request * request, mrs_audiocpp_chunk_progress_fn callback, void * context) {
+    if (request == nullptr) return fail(AUDIOCPP_ERR_INVALID_ARGUMENT, "request must be non-null");
+    return guard([&] {
+        request->request.chunk_progress = {};
+        if (callback != nullptr) {
+            request->request.chunk_progress = [callback, context](size_t completed, size_t total) {
+                return callback(completed, total, context) != 0;
+            };
+        }
+        return AUDIOCPP_OK;
+    });
+}
