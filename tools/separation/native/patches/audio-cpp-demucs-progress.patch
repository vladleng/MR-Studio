+/* MR Studio extension v1 (not part of upstream ABI 0.2). Demucs offline
+ * reports real completed chunks synchronously on the inference thread. Return
+ * zero to stop between chunks. Callback/context must outlive session_run;
+ * callbacks must not throw or call back into this session. NULL clears it. */
+#define AUDIOCPP_MRS_CHUNK_PROGRESS_VERSION 1
+typedef int (*mrs_audiocpp_chunk_progress_fn)(size_t completed, size_t total, void * context);
+AUDIOCPP_API audiocpp_status mrs_audiocpp_request_set_chunk_progress(
+    audiocpp_request * request, mrs_audiocpp_chunk_progress_fn callback, void * context);
+
